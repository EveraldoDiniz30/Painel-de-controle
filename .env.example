# Banco de dados. Em desenvolvimento, SQLite local (zero-config).
# Em produção, trocar para PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# Chave usada pelo NextAuth/Auth.js para assinar sessões (JWT).
# Gerar uma nova em produção com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-forte-em-producao"
NEXTAUTH_URL="http://localhost:3000"

# --- Integrações futuras (Fase 13) ---
# Nenhuma credencial real deve ser commitada. Preencher apenas quando
# a integração for de fato configurada.
# MERCADO_LIVRE_CLIENT_ID=
# MERCADO_LIVRE_CLIENT_SECRET=
